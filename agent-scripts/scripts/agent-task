#!/usr/bin/env python3
import os
import sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import waitlib


CLAUDE_READY = "❯|auto mode on|accept edits on"


def info_from(stdout: str) -> dict:
    result = waitlib.json_result(stdout)
    if not isinstance(result, dict):
        raise ValueError("herdr agent get returned no object")
    info = result.get("pane", result.get("agent", result))
    if not isinstance(info, dict):
        raise ValueError("herdr agent get returned no agent object")
    return info


def main() -> int:
    script = waitlib.Script("agent-task", timeout=1800)
    script.parser.add_argument("--pane", required=True)
    script.parser.add_argument("--line")
    script.parser.add_argument("--claude", action="store_true")
    script.parser.add_argument("--marker")
    script.parser.add_argument("--no-startup", action="store_true")
    args = script.parse()
    script.target = f"pane:{args.pane}"
    if bool(args.brief) == bool(args.line):
        script.fail(waitlib.EXIT_GONE, "missing", {"error": "use exactly one of --brief or --line"})
    line = f"Read your brief in full and follow it: {args.brief}" if args.brief else args.line
    runner = waitlib.Runner(args.fixture)
    poller = waitlib.Poller(script, runner)

    if not args.no_startup:
        # Claude Code prints no fixed banner; ready is the prompt line or the permission-mode footer.
        # The startup ceiling follows --timeout, capped at 60 s; --timeout 0 keeps a 30 s ceiling.
        startup_timeout = min(args.timeout, 60) if args.timeout > 0 else 30
        if args.marker:
            expect = {"match": args.marker}
        elif args.claude:
            expect = {"regex": CLAUDE_READY}
        else:
            expect = {"match": "Pi can explain its own features"}
        code, _, stderr = waitlib.wait_for_output(
            script, poller, args.pane, source="recent-unwrapped", timeout=startup_timeout, baseline=[], **expect,
        )
        if code != 0:
            if waitlib.gone_error(stderr):
                script.fail(waitlib.EXIT_GONE, "gone", {"error": stderr.strip()})
            if code == 1:
                script.fail(waitlib.EXIT_TIMEOUT, "timeout", {"stage": "startup"})
            script.fail(waitlib.EXIT_TOOL, "tool-failure", {"error": stderr.strip()})

    settle = ["herdr", "agent", "wait", args.pane, "--timeout", "10000"]
    code, _, stderr = poller.run(settle, timeout=15)
    # herdr registers a fresh agent a moment after its prompt line shows; at startup that is not "gone".
    startup_deadline = script.started + startup_timeout if not args.no_startup else script.clock.now()
    while code != 0 and "agent_not_found" in stderr.lower() and script.clock.now() < startup_deadline:
        script.clock.sleep(2)
        code, _, stderr = poller.run(settle, timeout=15)
    if code != 0:
        if waitlib.gone_error(stderr):
            script.fail(waitlib.EXIT_GONE, "gone", {"error": stderr.strip()})
        if code == 1:
            script.fail(waitlib.EXIT_TIMEOUT, "timeout", {"stage": "settle"})
        script.fail(waitlib.EXIT_TOOL, "tool-failure", {"error": stderr.strip()})

    while True:
        code, stdout, stderr = poller.run(["herdr", "agent", "get", args.pane])
        if code != 0:
            if waitlib.gone_error(stderr):
                script.fail(waitlib.EXIT_GONE, "gone", {"error": stderr.strip()})
            script.fail(waitlib.EXIT_TOOL, "tool-failure", {"error": stderr.strip()})
        try:
            status = info_from(stdout).get("agent_status")
        except (ValueError, TypeError) as error:
            script.fail(waitlib.EXIT_TOOL, "tool-failure", {"error": str(error)})
        # During startup herdr can report blocked or unknown for a few seconds before the agent settles.
        if status in {"idle", "done"} or script.clock.now() >= startup_deadline:
            break
        script.clock.sleep(2)
    if status == "blocked":
        script.fail(waitlib.EXIT_GONE, "blocked", {"status": status})
    if status not in {"idle", "done"}:
        script.fail(waitlib.EXIT_TOOL, "tool-failure", {"status": status})
    script.clock.sleep(2)

    prompt = ["herdr", "agent", "prompt", args.pane, line, "--wait", "--until", "working", "--timeout", "20000"]
    code, _, stderr = runner.run(prompt, timeout=25)
    if code != 0 and "agent_not_found" in stderr.lower():
        script.clock.sleep(2)
        code, _, stderr = runner.run(prompt, timeout=25)
    if code != 0:
        read_code, screen, read_error = runner.run(["herdr", "pane", "read", args.pane, "--source", "recent", "--lines", "20"])
        if read_code != 0:
            screen = read_error
        script.fail(waitlib.EXIT_TOOL, "prompt-failed", {"screen": screen.rstrip()})
    prompted_at = script.clock.timestamp()
    if args.timeout != 0:
        claude_baseline = None
        if args.claude:
            code, claude_baseline, stderr = waitlib.pane_lines(poller, args.pane)
            if code != 0:
                if waitlib.gone_error(stderr):
                    script.fail(waitlib.EXIT_GONE, "gone", {"error": stderr.strip()})
                script.fail(waitlib.EXIT_TOOL, "tool-failure", {"error": stderr.strip()})

        timeout_ms = str(int(args.timeout * 1000))
        if args.claude:
            code, _, stderr = waitlib.wait_for_output(
                script, poller, args.pane, regex="(?i)deviations",
                source="recent-unwrapped", timeout=args.timeout,
                baseline=claude_baseline,
            )
        else:
            settle = ["herdr", "agent", "wait", args.pane, "--timeout", timeout_ms]
            code, _, stderr = poller.run(settle, timeout=max(args.timeout + 5, 5))
        if code != 0:
            if waitlib.gone_error(stderr):
                script.fail(waitlib.EXIT_GONE, "gone", {"error": stderr.strip()})
            if code == 1:
                script.fail(waitlib.EXIT_TIMEOUT, "timeout", {})
            script.fail(waitlib.EXIT_TOOL, "tool-failure", {"error": stderr.strip()})
    code, stdout, stderr = poller.run(["herdr", "agent", "get", args.pane])
    if code != 0:
        if waitlib.gone_error(stderr):
            script.fail(waitlib.EXIT_GONE, "gone", {"error": stderr.strip()})
        script.fail(waitlib.EXIT_TOOL, "tool-failure", {"error": stderr.strip()})
    try:
        info = info_from(stdout)
    except (ValueError, TypeError) as error:
        script.fail(waitlib.EXIT_TOOL, "tool-failure", {"error": str(error)})
    detail = {
        "status": info.get("agent_status", info.get("status")),
        "session": info.get("agent_session", info.get("session")),
        "prompted_at": prompted_at,
    }
    script.emit("settled", detail)
    return 0


if __name__ == "__main__":
    main()
