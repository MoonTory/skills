#!/usr/bin/env python3
import os
import sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import waitlib

import re


def has_field(text: str, field: str) -> bool:
    name = re.escape(field.strip())
    patterns = [
        rf"^\s*#{{1,6}}\s*{name}\b",
        rf"^\s*\*\*{name}\*\*\s*:?.*$",
        rf"^\s*{name}\s*:?[ \t]*$",
    ]
    return any(re.search(pattern, text, re.IGNORECASE | re.MULTILINE) for pattern in patterns)


def main() -> int:
    script = waitlib.Script("brief-check", timeout=30)
    script.parser.add_argument("--require", default="goal,scope,acceptance,verify,report,timebox")
    args = script.parse()
    if not args.brief:
        script.fail(waitlib.EXIT_GONE, "missing", {"fields": ["brief"]})
    script.target = f"brief:{args.brief}"
    runner = waitlib.Runner(args.fixture)
    try:
        text = str(runner.fixture["brief"]) if runner.is_fixture and "brief" in runner.fixture else runner.text(args.brief)
    except OSError as error:
        if runner.is_fixture:
            script.fail(waitlib.EXIT_TOOL, "tool-failure", {"error": str(error)})
        script.fail(waitlib.EXIT_GONE, "gone", {"error": str(error)})
    fields = [field.strip() for field in args.require.split(",") if field.strip()]
    missing = [field for field in fields if not has_field(text, field)]
    if missing:
        script.fail(waitlib.EXIT_GONE, "missing", {"fields": missing})
    script.emit("ok", {})
    return 0


if __name__ == "__main__":
    main()
